// Prisma schema for Drink Shop Management System (DSMS)
// Source of truth for structure: docs/DATABASE.md + docs/DECISIONS.md — do not diverge without updating both.
// Naming: DB columns/tables are snake_case (docs/DATABASE.md §1); Prisma fields are camelCase and @map()'d to snake_case.
// Connection URL lives in prisma.config.ts + .env (DATABASE_URL) — Prisma 7 driver-adapter workflow, see lib/prisma.ts.

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  // Default ESM output uses `import.meta.url` internally, which crashes any
  // consumer that loads it through a CJS transform — Playwright's e2e test
  // runner does this (unlike Next.js's bundler or tsx, which both handle ESM
  // fine), so every e2e spec that touched the real Prisma client failed at
  // import time with "Cannot use 'import.meta' outside a module". CJS output
  // works everywhere.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// DECISIONS.md D14 — ⚠️ role list pending user confirmation (Hard-Stop per AGENTS.md §2)
enum UserRole {
  owner
  manager
  shift_supervisor
  cashier
  employee
  accountant

  @@map("user_role")
}

/// DECISIONS.md D2 — the only 3 units a recipe may reference
enum BaseUnit {
  gram
  ml
  piece

  @@map("base_unit")
}

/// DECISIONS.md D11 — `transfer` is schema-ready only, not implemented in MVP
enum MovementType {
  stock_in
  stock_out
  adjustment
  reversal
  transfer

  @@map("movement_type")
}

enum VatMode {
  inclusive
  exclusive
  none

  @@map("vat_mode")
}

enum ModifierSelectionType {
  single
  multiple

  @@map("modifier_selection_type")
}

/// A menu category belongs to exactly one high-level type — Food or Drink —
/// so the menu list, POS, and reports can group/filter above the free-text
/// category name (e.g. "ชา"/"กาแฟ" are drink; "อาหาร" is food).
enum MenuCategoryType {
  food
  drink

  @@map("menu_category_type")
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled

  @@map("purchase_order_status")
}

enum PaymentMethod {
  cash
  qr

  @@map("payment_method")
}

enum RefundRequestStatus {
  pending
  approved
  rejected

  @@map("refund_request_status")
}

// DECISIONS.md D4: default warn-only (non-blocking, flag is_stock_deficit),
// Owner may opt into strict_block globally or per ingredient (Phase 12)
enum StockDeficitPolicy {
  warn_only
  strict_block

  @@map("stock_deficit_policy")
}

enum ReceiptPaperWidth {
  mm58
  mm80

  @@map("receipt_paper_width")
}

// ============================================================================
// Identity & Access — DATABASE.md §9, DECISIONS.md D6, D13, D14, D15
// Note: RBAC is enum-based (not separate roles/permissions tables) — the
// authoritative permission matrix lives in code + docs/SECURITY.md §1, kept
// in sync manually (see AGENTS.md §9 Maker-Checker gate).
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  fullName         String    @map("full_name")
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  invitesSent UserInvite[] @relation("InvitedBy")

  @@map("users")
}

/// DECISIONS.md D6 — bootstrap owner (first signup) + invite-only afterwards
model UserInvite {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  invitedById String    @map("invited_by")
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("user_invites")
}

// ============================================================================
// Settings — DATABASE.md §10, §11, DECISIONS.md D8, D9, D16
// Singleton-style tables (expected to hold exactly one row in MVP single-branch scope)
// ============================================================================

model CompanySettings {
  id                   String             @id @default(uuid())
  timezone             String             @default("Asia/Bangkok")
  businessDayStartHour Int                @default(5) @map("business_day_start_hour") // 0-23
  isVatRegistered      Boolean            @default(false) @map("is_vat_registered")
  taxId                String?            @map("tax_id") // เลขประจำตัวผู้เสียภาษี 13 หลัก
  // registeredName/registeredAddress double as the general "company info" shown
  // on every receipt (FR-SET-01), not only the formal tax invoice fields (D16) —
  // a non-VAT-registered shop still wants its name/address printed, just without
  // the "ใบกำกับภาษี" label.
  registeredName       String?            @map("registered_name")
  registeredAddress    String?            @map("registered_address")
  companyPhone         String?            @map("company_phone")
  receiptFooterMessage String?            @map("receipt_footer_message")
  receiptPaperWidth    ReceiptPaperWidth  @default(mm80) @map("receipt_paper_width")
  openTime             String?            @map("open_time") // "HH:MM", display-only on receipts
  closeTime            String?            @map("close_time") // "HH:MM", display-only on receipts
  // Global default for FR-SET-04/D4 — Ingredient.stockDeficitPolicyOverride
  // wins per-ingredient when set; falls back to this otherwise.
  stockDeficitPolicy   StockDeficitPolicy @default(warn_only) @map("stock_deficit_policy")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  @@map("company_settings")
}

model TaxSettings {
  id                      String   @id @default(uuid())
  vatMode                 VatMode  @default(inclusive) @map("vat_mode")
  vatRate                 Decimal  @default(7.00) @map("vat_rate") @db.Decimal(5, 2)
  refundApprovalThreshold Decimal  @default(500.00) @map("refund_approval_threshold") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("tax_settings")
}

// FR-SET-05 / DECISIONS.md D12 review trigger: configurable master list for
// stock_out reason codes (Owner-managed in Settings), replacing the Phase 6
// hardcoded default list. `code` is the same opaque string already stored in
// inventory_movements.reason_code — seeded rows keep the original default
// codes ("spoiled", "broken", ...) so historical movements stay valid.
model ReasonCode {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  @@map("reason_codes")
}

// ============================================================================
// Catalog — DATABASE.md §6, §7, DECISIONS.md D1, D2, D3
// ============================================================================

model Supplier {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  name        String
  contactInfo String?   @map("contact_info")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Ingredient {
  id                         String              @id @default(uuid())
  branchId                   String              @map("branch_id")
  name                       String
  baseUnit                   BaseUnit            @map("base_unit")
  costPerUnit                Decimal             @default(0) @map("cost_per_unit") @db.Decimal(12, 4)
  currentStockQty            Decimal             @default(0) @map("current_stock_qty") @db.Decimal(12, 4)
  lowStockThreshold          Decimal?            @map("low_stock_threshold") @db.Decimal(12, 4)
  // DECISIONS.md D4 / FR-SET-04: null = follow CompanySettings.stockDeficitPolicy
  stockDeficitPolicyOverride StockDeficitPolicy? @map("stock_deficit_policy_override")
  supplierId                 String?             @map("supplier_id")
  deletedAt                  DateTime?           @map("deleted_at")
  createdAt                  DateTime            @default(now()) @map("created_at")
  createdBy                  String              @map("created_by")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  updatedBy                  String?             @map("updated_by")

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  unitConversions    UnitConversion[]
  recipeIngredients  RecipeIngredient[]
  modifiers          Modifier[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

/// DECISIONS.md D2 — purchase_unit -> base_unit conversion, 1 ingredient can have many
model UnitConversion {
  id               String   @id @default(uuid())
  ingredientId     String   @map("ingredient_id")
  purchaseUnitName String   @map("purchase_unit_name")
  conversionFactor Decimal  @map("conversion_factor") @db.Decimal(12, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("unit_conversions")
}

model Recipe {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  name      String
  yield     Decimal   @default(1) @db.Decimal(10, 2)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  ingredients      RecipeIngredient[]
  menus            Menu[]
  variantOverrides MenuVariant[]      @relation("VariantOverrideRecipe")

  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  ingredientId String  @map("ingredient_id")
  quantity     Decimal @db.Decimal(12, 4) // unit = ingredient.baseUnit

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("recipe_ingredients")
}

model MenuCategory {
  id        String           @id @default(uuid())
  branchId  String           @map("branch_id")
  name      String
  type      MenuCategoryType @default(drink)
  deletedAt DateTime?        @map("deleted_at")
  createdAt DateTime         @default(now()) @map("created_at")
  createdBy String           @map("created_by")
  updatedAt DateTime         @updatedAt @map("updated_at")
  updatedBy String?          @map("updated_by")

  menus Menu[]

  @@map("menu_categories")
}

model Menu {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  categoryId  String?   @map("category_id")
  recipeId    String    @map("recipe_id")
  name        String
  basePrice   Decimal   @map("base_price") @db.Decimal(12, 2)
  imageUrl    String?   @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  category       MenuCategory?          @relation(fields: [categoryId], references: [id])
  recipe         Recipe                 @relation(fields: [recipeId], references: [id])
  variants       MenuVariant[]
  modifierGroups MenuModifierGroup[]
  saleItems      SalesTransactionItem[]

  @@map("menus")
}

/// DECISIONS.md D3 — Size S/M/L etc. `recipeMultiplier` XOR `overrideRecipeId`
model MenuVariant {
  id               String    @id @default(uuid())
  menuId           String    @map("menu_id")
  name             String
  recipeMultiplier Decimal?  @map("recipe_multiplier") @db.Decimal(6, 3)
  overrideRecipeId String?   @map("override_recipe_id")
  priceDelta       Decimal   @default(0) @map("price_delta") @db.Decimal(12, 2)
  isDefault        Boolean   @default(false) @map("is_default")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  menu           Menu                   @relation(fields: [menuId], references: [id])
  overrideRecipe Recipe?                @relation("VariantOverrideRecipe", fields: [overrideRecipeId], references: [id])
  saleItems      SalesTransactionItem[]

  @@map("menu_variants")
}

/// DECISIONS.md D3 — e.g. "ความหวาน", "Topping"; join to Menu is many-to-many
model ModifierGroup {
  id            String                @id @default(uuid())
  branchId      String                @map("branch_id")
  name          String
  selectionType ModifierSelectionType @default(single) @map("selection_type")
  isRequired    Boolean               @default(false) @map("is_required")
  deletedAt     DateTime?             @map("deleted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  modifiers Modifier[]
  menus     MenuModifierGroup[]

  @@map("modifier_groups")
}

model MenuModifierGroup {
  id              String @id @default(uuid())
  menuId          String @map("menu_id")
  modifierGroupId String @map("modifier_group_id")

  menu          Menu          @relation(fields: [menuId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuId, modifierGroupId])
  @@map("menu_modifier_groups")
}

/// DECISIONS.md D3 — e.g. "ไข่มุก" (ผูก ingredient) or "หวาน 50%" (ไม่ผูก)
model Modifier {
  id                 String    @id @default(uuid())
  modifierGroupId    String    @map("modifier_group_id")
  name               String
  ingredientId       String?   @map("ingredient_id")
  ingredientQuantity Decimal?  @map("ingredient_quantity") @db.Decimal(12, 4)
  priceDelta         Decimal   @default(0) @map("price_delta") @db.Decimal(12, 2)
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  modifierGroup     ModifierGroup                  @relation(fields: [modifierGroupId], references: [id])
  ingredient        Ingredient?                    @relation(fields: [ingredientId], references: [id])
  saleItemModifiers SalesTransactionItemModifier[]

  @@map("modifiers")
}

// ============================================================================
// Purchase — DATABASE.md §5, DECISIONS.md D1
// ============================================================================

model PurchaseOrder {
  id         String              @id @default(uuid())
  branchId   String              @map("branch_id")
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(pending)
  orderedAt  DateTime            @default(now()) @map("ordered_at")
  receivedAt DateTime?           @map("received_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  createdBy  String              @map("created_by")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  updatedBy  String?             @map("updated_by")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String  @map("purchase_order_id")
  ingredientId     String  @map("ingredient_id")
  purchaseUnitName String  @map("purchase_unit_name")
  quantity         Decimal @db.Decimal(12, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 4) // price per purchase_unit

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([purchaseOrderId])
  @@index([ingredientId])
  @@map("purchase_order_items")
}

// ============================================================================
// Inventory — DATABASE.md §3, §8, DECISIONS.md D4, D11, D12 (append-only)
// ============================================================================

model InventoryMovement {
  id             String       @id @default(uuid())
  branchId       String       @map("branch_id")
  ingredientId   String       @map("ingredient_id")
  movementType   MovementType @map("movement_type")
  quantity       Decimal      @db.Decimal(12, 4) // unit = ingredient.baseUnit
  reasonCode     String?      @map("reason_code")
  isStockDeficit Boolean      @default(false) @map("is_stock_deficit")
  reversalOfId   String?      @map("reversal_of_id")
  referenceType  String?      @map("reference_type") // e.g. "purchase_order_item" | "sales_transaction_item"
  referenceId    String?      @map("reference_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String       @map("created_by")

  ingredient Ingredient          @relation(fields: [ingredientId], references: [id])
  reversalOf InventoryMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversals  InventoryMovement[] @relation("MovementReversal")

  // Performance (TESTING.md §10): Dashboard/Reports filter by createdAt range
  // on every load, and void/refund + the inventory report look up by
  // ingredient and by (referenceType, referenceId) — all full table scans
  // without these, and this table is append-only (grows forever).
  @@index([createdAt])
  @@index([ingredientId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ============================================================================
// Sales — DATABASE.md §8, DECISIONS.md D3, D4, D5, D9, D14, D16 (append-only)
// ============================================================================

model SalesTransaction {
  id                 String        @id @default(uuid())
  branchId           String        @map("branch_id")
  cashierId          String        @map("cashier_id")
  paymentMethod      PaymentMethod @map("payment_method")
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  roundingAdjustment Decimal       @default(0) @map("rounding_adjustment") @db.Decimal(6, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  vatModeSnapshot    VatMode       @map("vat_mode_snapshot")
  vatRateSnapshot    Decimal       @map("vat_rate_snapshot") @db.Decimal(5, 2)
  taxInvoiceNumber   Int?          @map("tax_invoice_number") // DECISIONS.md D16, running number, not reset
  reversalOfId       String?       @map("reversal_of_id")
  voidReason         String?       @map("void_reason")
  approvedBy         String?       @map("approved_by") // required when reversal is a cross-shift refund
  createdAt          DateTime      @default(now()) @map("created_at")
  createdBy          String        @map("created_by")

  items          SalesTransactionItem[]
  reversalOf     SalesTransaction?      @relation("SaleReversal", fields: [reversalOfId], references: [id])
  reversals      SalesTransaction[]     @relation("SaleReversal")
  refundRequests RefundRequest[]

  // Performance (TESTING.md §10): Dashboard/Reports bucket every query by
  // createdAt range; POS's recent-transactions list filters by cashierId;
  // void/refund look up the reversal row by reversalOfId — all on this
  // append-only, ever-growing table.
  @@index([createdAt])
  @@index([cashierId])
  @@index([reversalOfId])
  @@map("sales_transactions")
}

model SalesTransactionItem {
  id                 String   @id @default(uuid())
  salesTransactionId String   @map("sales_transaction_id")
  menuId             String   @map("menu_id")
  menuVariantId      String?  @map("menu_variant_id")
  quantity           Int      @default(1)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  costAtSaleTime     Decimal  @map("cost_at_sale_time") @db.Decimal(12, 4)
  discountAmount     Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  reversedQuantity   Int      @default(0) @map("reversed_quantity") // reserved for future partial refund — DECISIONS.md D-Note
  createdAt          DateTime @default(now()) @map("created_at")

  salesTransaction SalesTransaction               @relation(fields: [salesTransactionId], references: [id])
  menu             Menu                           @relation(fields: [menuId], references: [id])
  menuVariant      MenuVariant?                   @relation(fields: [menuVariantId], references: [id])
  modifiers        SalesTransactionItemModifier[]

  @@index([salesTransactionId])
  @@index([menuId])
  @@map("sales_transaction_items")
}

model SalesTransactionItemModifier {
  id                     String   @id @default(uuid())
  salesTransactionItemId String   @map("sales_transaction_item_id")
  modifierId             String   @map("modifier_id")
  modifierNameSnapshot   String   @map("modifier_name_snapshot")
  priceDeltaSnapshot     Decimal  @map("price_delta_snapshot") @db.Decimal(12, 2)
  ingredientCostSnapshot Decimal? @map("ingredient_cost_snapshot") @db.Decimal(12, 4)
  createdAt              DateTime @default(now()) @map("created_at")

  salesTransactionItem SalesTransactionItem @relation(fields: [salesTransactionItemId], references: [id])
  modifier             Modifier             @relation(fields: [modifierId], references: [id])

  @@map("sales_transaction_item_modifiers")
}

/// DECISIONS.md D5, D14 — cross-shift refund approval queue (Shift Supervisor ≤ threshold, else Manager/Owner)
model RefundRequest {
  id                 String              @id @default(uuid())
  salesTransactionId String              @map("sales_transaction_id")
  requestedBy        String              @map("requested_by")
  reason             String
  status             RefundRequestStatus @default(pending)
  decidedBy          String?             @map("decided_by")
  decidedAt          DateTime?           @map("decided_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  salesTransaction SalesTransaction @relation(fields: [salesTransactionId], references: [id])

  @@index([salesTransactionId])
  @@index([status])
  @@map("refund_requests")
}

// ============================================================================
// Finance — DATABASE.md §5 (append-only expense_entries)
// ============================================================================

model ExpenseCategory {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  name      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  entries ExpenseEntry[]

  @@map("expense_categories")
}

model ExpenseEntry {
  id           String   @id @default(uuid())
  branchId     String   @map("branch_id")
  categoryId   String   @map("category_id")
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  slipUrl      String?  @map("slip_url") // storage path in the private "expense-slips" bucket, not a public URL
  reversalOfId String?  @map("reversal_of_id")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") // may be Owner/Manager/Accountant — DECISIONS.md D14

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  reversalOf ExpenseEntry?   @relation("ExpenseReversal", fields: [reversalOfId], references: [id])
  reversals  ExpenseEntry[]  @relation("ExpenseReversal")

  @@index([createdAt])
  @@index([categoryId])
  @@map("expense_entries")
}
