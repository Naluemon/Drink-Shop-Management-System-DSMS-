// Prisma schema for Drink Shop Management System (DSMS)
// Source of truth for structure: docs/DATABASE.md + docs/DECISIONS.md — do not diverge without updating both.
// Naming: DB columns/tables are snake_case (docs/DATABASE.md §1); Prisma fields are camelCase and @map()'d to snake_case.
// Connection URL lives in prisma.config.ts + .env (DATABASE_URL) — Prisma 7 driver-adapter workflow, see lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// DECISIONS.md D14 — ⚠️ role list pending user confirmation (Hard-Stop per AGENTS.md §2)
enum UserRole {
  owner
  manager
  shift_supervisor
  cashier
  employee
  accountant

  @@map("user_role")
}

/// DECISIONS.md D2 — the only 3 units a recipe may reference
enum BaseUnit {
  gram
  ml
  piece

  @@map("base_unit")
}

/// DECISIONS.md D11 — `transfer` is schema-ready only, not implemented in MVP
enum MovementType {
  stock_in
  stock_out
  adjustment
  reversal
  transfer

  @@map("movement_type")
}

enum VatMode {
  inclusive
  exclusive
  none

  @@map("vat_mode")
}

enum ModifierSelectionType {
  single
  multiple

  @@map("modifier_selection_type")
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled

  @@map("purchase_order_status")
}

enum PaymentMethod {
  cash
  qr

  @@map("payment_method")
}

enum RefundRequestStatus {
  pending
  approved
  rejected

  @@map("refund_request_status")
}

// ============================================================================
// Identity & Access — DATABASE.md §9, DECISIONS.md D6, D13, D14, D15
// Note: RBAC is enum-based (not separate roles/permissions tables) — the
// authoritative permission matrix lives in code + docs/SECURITY.md §1, kept
// in sync manually (see AGENTS.md §9 Maker-Checker gate).
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  fullName         String    @map("full_name")
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  invitesSent UserInvite[] @relation("InvitedBy")

  @@map("users")
}

/// DECISIONS.md D6 — bootstrap owner (first signup) + invite-only afterwards
model UserInvite {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  invitedById String    @map("invited_by")
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("user_invites")
}

// ============================================================================
// Settings — DATABASE.md §10, §11, DECISIONS.md D8, D9, D16
// Singleton-style tables (expected to hold exactly one row in MVP single-branch scope)
// ============================================================================

model CompanySettings {
  id                   String   @id @default(uuid())
  timezone             String   @default("Asia/Bangkok")
  businessDayStartHour Int      @default(5) @map("business_day_start_hour") // 0-23
  isVatRegistered      Boolean  @default(false) @map("is_vat_registered")
  taxId                String?  @map("tax_id") // เลขประจำตัวผู้เสียภาษี 13 หลัก
  registeredName       String?  @map("registered_name")
  registeredAddress    String?  @map("registered_address")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model TaxSettings {
  id                      String   @id @default(uuid())
  vatMode                 VatMode  @default(inclusive) @map("vat_mode")
  vatRate                 Decimal  @default(7.00) @db.Decimal(5, 2) @map("vat_rate")
  refundApprovalThreshold Decimal  @default(500.00) @db.Decimal(12, 2) @map("refund_approval_threshold")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("tax_settings")
}

// ============================================================================
// Catalog — DATABASE.md §6, §7, DECISIONS.md D1, D2, D3
// ============================================================================

model Supplier {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  name        String
  contactInfo String?   @map("contact_info")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Ingredient {
  id                String    @id @default(uuid())
  branchId          String    @map("branch_id")
  name              String
  baseUnit          BaseUnit  @map("base_unit")
  costPerUnit       Decimal   @default(0) @db.Decimal(12, 4) @map("cost_per_unit")
  currentStockQty   Decimal   @default(0) @db.Decimal(12, 4) @map("current_stock_qty")
  lowStockThreshold Decimal?  @db.Decimal(12, 4) @map("low_stock_threshold")
  supplierId        String?   @map("supplier_id")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String    @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  unitConversions    UnitConversion[]
  recipeIngredients  RecipeIngredient[]
  modifiers          Modifier[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

/// DECISIONS.md D2 — purchase_unit -> base_unit conversion, 1 ingredient can have many
model UnitConversion {
  id               String   @id @default(uuid())
  ingredientId     String   @map("ingredient_id")
  purchaseUnitName String   @map("purchase_unit_name")
  conversionFactor Decimal  @db.Decimal(12, 4) @map("conversion_factor")
  createdAt        DateTime @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("unit_conversions")
}

model Recipe {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  name      String
  yield     Decimal   @default(1) @db.Decimal(10, 2)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  ingredients      RecipeIngredient[]
  menus            Menu[]
  variantOverrides MenuVariant[]      @relation("VariantOverrideRecipe")

  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String  @map("recipe_id")
  ingredientId String  @map("ingredient_id")
  quantity     Decimal @db.Decimal(12, 4) // unit = ingredient.baseUnit

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("recipe_ingredients")
}

model MenuCategory {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  name      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  menus Menu[]

  @@map("menu_categories")
}

model Menu {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  categoryId  String?   @map("category_id")
  recipeId    String    @map("recipe_id")
  name        String
  basePrice   Decimal   @db.Decimal(12, 2) @map("base_price")
  imageUrl    String?   @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  category       MenuCategory?          @relation(fields: [categoryId], references: [id])
  recipe         Recipe                 @relation(fields: [recipeId], references: [id])
  variants       MenuVariant[]
  modifierGroups MenuModifierGroup[]
  saleItems      SalesTransactionItem[]

  @@map("menus")
}

/// DECISIONS.md D3 — Size S/M/L etc. `recipeMultiplier` XOR `overrideRecipeId`
model MenuVariant {
  id               String    @id @default(uuid())
  menuId           String    @map("menu_id")
  name             String
  recipeMultiplier Decimal?  @db.Decimal(6, 3) @map("recipe_multiplier")
  overrideRecipeId String?   @map("override_recipe_id")
  priceDelta       Decimal   @default(0) @db.Decimal(12, 2) @map("price_delta")
  isDefault        Boolean   @default(false) @map("is_default")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  menu           Menu                   @relation(fields: [menuId], references: [id])
  overrideRecipe Recipe?                @relation("VariantOverrideRecipe", fields: [overrideRecipeId], references: [id])
  saleItems      SalesTransactionItem[]

  @@map("menu_variants")
}

/// DECISIONS.md D3 — e.g. "ความหวาน", "Topping"; join to Menu is many-to-many
model ModifierGroup {
  id            String                @id @default(uuid())
  branchId      String                @map("branch_id")
  name          String
  selectionType ModifierSelectionType @default(single) @map("selection_type")
  isRequired    Boolean               @default(false) @map("is_required")
  deletedAt     DateTime?             @map("deleted_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  modifiers Modifier[]
  menus     MenuModifierGroup[]

  @@map("modifier_groups")
}

model MenuModifierGroup {
  id              String @id @default(uuid())
  menuId          String @map("menu_id")
  modifierGroupId String @map("modifier_group_id")

  menu          Menu          @relation(fields: [menuId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([menuId, modifierGroupId])
  @@map("menu_modifier_groups")
}

/// DECISIONS.md D3 — e.g. "ไข่มุก" (ผูก ingredient) or "หวาน 50%" (ไม่ผูก)
model Modifier {
  id                 String    @id @default(uuid())
  modifierGroupId    String    @map("modifier_group_id")
  name               String
  ingredientId       String?   @map("ingredient_id")
  ingredientQuantity Decimal?  @db.Decimal(12, 4) @map("ingredient_quantity")
  priceDelta         Decimal   @default(0) @db.Decimal(12, 2) @map("price_delta")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  modifierGroup     ModifierGroup                   @relation(fields: [modifierGroupId], references: [id])
  ingredient        Ingredient?                     @relation(fields: [ingredientId], references: [id])
  saleItemModifiers SalesTransactionItemModifier[]

  @@map("modifiers")
}

// ============================================================================
// Purchase — DATABASE.md §5, DECISIONS.md D1
// ============================================================================

model PurchaseOrder {
  id         String              @id @default(uuid())
  branchId   String              @map("branch_id")
  supplierId String              @map("supplier_id")
  status     PurchaseOrderStatus @default(pending)
  orderedAt  DateTime            @default(now()) @map("ordered_at")
  receivedAt DateTime?           @map("received_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  createdBy  String              @map("created_by")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  updatedBy  String?             @map("updated_by")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String  @map("purchase_order_id")
  ingredientId     String  @map("ingredient_id")
  purchaseUnitName String  @map("purchase_unit_name")
  quantity         Decimal @db.Decimal(12, 4)
  unitPrice        Decimal @db.Decimal(12, 4) @map("unit_price") // price per purchase_unit

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("purchase_order_items")
}

// ============================================================================
// Inventory — DATABASE.md §3, §8, DECISIONS.md D4, D11, D12 (append-only)
// ============================================================================

model InventoryMovement {
  id             String       @id @default(uuid())
  branchId       String       @map("branch_id")
  ingredientId   String       @map("ingredient_id")
  movementType   MovementType @map("movement_type")
  quantity       Decimal      @db.Decimal(12, 4) // unit = ingredient.baseUnit
  reasonCode     String?      @map("reason_code")
  isStockDeficit Boolean      @default(false) @map("is_stock_deficit")
  reversalOfId   String?      @map("reversal_of_id")
  referenceType  String?      @map("reference_type") // e.g. "purchase_order_item" | "sales_transaction_item"
  referenceId    String?      @map("reference_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      String       @map("created_by")

  ingredient Ingredient          @relation(fields: [ingredientId], references: [id])
  reversalOf InventoryMovement?  @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversals  InventoryMovement[] @relation("MovementReversal")

  @@map("inventory_movements")
}

// ============================================================================
// Sales — DATABASE.md §8, DECISIONS.md D3, D4, D5, D9, D14, D16 (append-only)
// ============================================================================

model SalesTransaction {
  id                 String        @id @default(uuid())
  branchId           String        @map("branch_id")
  cashierId          String        @map("cashier_id")
  paymentMethod      PaymentMethod @map("payment_method")
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2) @map("discount_amount")
  roundingAdjustment Decimal       @default(0) @db.Decimal(6, 2) @map("rounding_adjustment")
  totalAmount        Decimal       @db.Decimal(12, 2) @map("total_amount")
  vatModeSnapshot    VatMode       @map("vat_mode_snapshot")
  vatRateSnapshot    Decimal       @db.Decimal(5, 2) @map("vat_rate_snapshot")
  taxInvoiceNumber   Int?          @map("tax_invoice_number") // DECISIONS.md D16, running number, not reset
  reversalOfId       String?       @map("reversal_of_id")
  voidReason         String?       @map("void_reason")
  approvedBy         String?       @map("approved_by") // required when reversal is a cross-shift refund
  createdAt          DateTime      @default(now()) @map("created_at")
  createdBy          String        @map("created_by")

  items          SalesTransactionItem[]
  reversalOf     SalesTransaction?       @relation("SaleReversal", fields: [reversalOfId], references: [id])
  reversals      SalesTransaction[]      @relation("SaleReversal")
  refundRequests RefundRequest[]

  @@map("sales_transactions")
}

model SalesTransactionItem {
  id                 String   @id @default(uuid())
  salesTransactionId String   @map("sales_transaction_id")
  menuId             String   @map("menu_id")
  menuVariantId      String?  @map("menu_variant_id")
  quantity           Int      @default(1)
  unitPrice          Decimal  @db.Decimal(12, 2) @map("unit_price")
  costAtSaleTime     Decimal  @db.Decimal(12, 4) @map("cost_at_sale_time")
  discountAmount     Decimal  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  reversedQuantity   Int      @default(0) @map("reversed_quantity") // reserved for future partial refund — DECISIONS.md D-Note
  createdAt          DateTime @default(now()) @map("created_at")

  salesTransaction SalesTransaction               @relation(fields: [salesTransactionId], references: [id])
  menu             Menu                           @relation(fields: [menuId], references: [id])
  menuVariant      MenuVariant?                   @relation(fields: [menuVariantId], references: [id])
  modifiers        SalesTransactionItemModifier[]

  @@map("sales_transaction_items")
}

model SalesTransactionItemModifier {
  id                     String   @id @default(uuid())
  salesTransactionItemId String   @map("sales_transaction_item_id")
  modifierId             String   @map("modifier_id")
  modifierNameSnapshot   String   @map("modifier_name_snapshot")
  priceDeltaSnapshot     Decimal  @db.Decimal(12, 2) @map("price_delta_snapshot")
  ingredientCostSnapshot Decimal? @db.Decimal(12, 4) @map("ingredient_cost_snapshot")
  createdAt              DateTime @default(now()) @map("created_at")

  salesTransactionItem SalesTransactionItem @relation(fields: [salesTransactionItemId], references: [id])
  modifier             Modifier             @relation(fields: [modifierId], references: [id])

  @@map("sales_transaction_item_modifiers")
}

/// DECISIONS.md D5, D14 — cross-shift refund approval queue (Shift Supervisor ≤ threshold, else Manager/Owner)
model RefundRequest {
  id                 String              @id @default(uuid())
  salesTransactionId String              @map("sales_transaction_id")
  requestedBy        String              @map("requested_by")
  reason             String
  status             RefundRequestStatus @default(pending)
  decidedBy          String?             @map("decided_by")
  decidedAt          DateTime?           @map("decided_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  salesTransaction SalesTransaction @relation(fields: [salesTransactionId], references: [id])

  @@map("refund_requests")
}

// ============================================================================
// Finance — DATABASE.md §5 (append-only expense_entries)
// ============================================================================

model ExpenseCategory {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  name      String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  entries ExpenseEntry[]

  @@map("expense_categories")
}

model ExpenseEntry {
  id           String   @id @default(uuid())
  branchId     String   @map("branch_id")
  categoryId   String   @map("category_id")
  amount       Decimal  @db.Decimal(12, 2)
  description  String?
  reversalOfId String?  @map("reversal_of_id")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by") // may be Owner/Manager/Accountant — DECISIONS.md D14

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  reversalOf ExpenseEntry?   @relation("ExpenseReversal", fields: [reversalOfId], references: [id])
  reversals  ExpenseEntry[]  @relation("ExpenseReversal")

  @@map("expense_entries")
}
